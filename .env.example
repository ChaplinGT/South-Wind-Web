# Copia este archivo a .env. Nunca subas .env al repositorio.
# En Vercel, Neon inyecta DATABASE_URL y DATABASE_URL_UNPOOLED. No hace falta commitearlas.

# Runtime de Prisma (con pooler en Neon). En local es la misma URL que la directa.
DATABASE_URL="postgresql://southwind:southwind@localhost:5432/southwind"

# Conexión directa para `prisma migrate deploy`. En Neon es la URL sin pooler.
# Si el marketplace solo muestra POSTGRES_URL_NON_POOLING, copie ese valor aquí.
DATABASE_URL_UNPOOLED="postgresql://southwind:southwind@localhost:5432/southwind"

# Clave de Bridge SOLO en el servidor. No use el prefijo NEXT_PUBLIC_.
# Vacía: el portal queda en modo simulado aunque BRIDGE_MOCK=false.
BRIDGE_API_KEY=

# Sandbox por defecto. Producción real: https://api.bridge.xyz/v0
BRIDGE_API_BASE_URL=https://api.sandbox.bridge.xyz/v0

# true, o ausente: fixtures. false y con BRIDGE_API_KEY: llama a BRIDGE_API_BASE_URL.
BRIDGE_MOCK=true

# PEM público del webhook (POST /webhooks). En una línea, con \n.
BRIDGE_WEBHOOK_PUBLIC_KEY=

# Firma de la cookie de sesión. Cámbiela por una cadena larga y aleatoria.
AUTH_SECRET=cambia-esta-clave-en-local-y-produccion-min-32

# URL pública. En el dominio final: https://portal.southwindglobalservices.com
# Si se omite en Vercel, se usa https://$VERCEL_URL. NEXTAUTH_URL se acepta como alias.
APP_URL=http://localhost:3000

# Opcional. Solo al sembrar. Si no están, el admin de demo usa el correo documentado.
# ADMIN_EMAIL=gabriel@southwindglobalservices.com
# ADMIN_PASSWORD=una-clave-larga-que-no-es-la-de-demo

# En Vercel: true hace que vercel-build ejecute el seed después de las migraciones.
# Vuelva a false en el siguiente deploy si no quiere resembrar en cada build.
SEED_ON_BUILD=false

# Comisión inicial si todavía no hay valor en la base. Luego se edita en el panel.
SOUTH_WIND_FEE_PERCENT=0.50
