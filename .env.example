# Copia este archivo a .env. Nunca subas .env al repositorio.

# SQLite local (la ruta es relativa a prisma/schema.prisma).
# En Supabase cambie el provider a "postgresql" y use la URI de la base.
DATABASE_URL="file:./dev.db"

# Clave de Bridge SOLO en el servidor. No use el prefijo NEXT_PUBLIC_.
# Sandbox: Dashboard de Bridge → API keys. No se imprime en logs ni en bridge:check.
BRIDGE_API_KEY=

# Base del API. Sandbox por defecto. Producción: https://api.bridge.xyz/v0
BRIDGE_API_BASE_URL=https://api.sandbox.bridge.xyz/v0

# true: fixtures locales, sin red y sin clave. false: llama al API real.
BRIDGE_MOCK=true

# PEM de la clave pública del webhook (la devuelve POST /webhooks).
# En .env puede ir en una sola línea con \n entre el encabezado y el cuerpo.
BRIDGE_WEBHOOK_PUBLIC_KEY=

# Secreto de la cookie de sesión. Cámbielo por una cadena larga y aleatoria.
AUTH_SECRET=cambia-esta-clave-en-local-y-produccion-min-32

# URL pública del portal (enlaces de verificación y de KYB simulado).
APP_URL=http://localhost:3000

# Comisión inicial de South Wind, en porcentaje. Editable luego en el panel admin.
SOUTH_WIND_FEE_PERCENT=0.50
